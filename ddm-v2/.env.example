# DDM v2 環境變數範本。複製為 .env 後填值（.env 不納版、各機獨立）：cp .env.example .env
# docker compose 會自動讀同目錄的 .env。

# ── PostgreSQL（docker：餵進 db 容器 + 組出容器內 DATABASE_URL=@db:5432）──
POSTGRES_USER=ddm_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ddm_v2
# 僅「本機非 docker」直接跑時需要（docker 部署會忽略，改用 @db:5432）：
# DATABASE_URL=postgresql+asyncpg://ddm_user:change-me@localhost:5432/ddm_v2
# 開發要主機 psql/alembic 才需發佈 DB port（疊 docker-compose.dev.yml）；被佔用時改這個：
# POSTGRES_HOST_PORT=15432

# ── 對外服務 port（你 browser 打的就是這個；容器內固定 8000）──
DDM_PORT=8877

# ── 安全 ──
# ENV=production 時 DDM_SECRET_KEY 必須是 32 字以上的真實隨機字串，否則啟動會報錯
ENV=development
DDM_SECRET_KEY=replace-with-a-real-32-char-min-secret
# 開機自動建為 admin 的員編（設成你真實、會登入的員編）
DDM_ADMIN_EMPLOYEE_NO=IEC141289
# true＝開機自動種 rule-set(計算必需) + demo worksheet(5555) + 詞彙 + 範本（idempotent）
# 第一次部署請設 true（否則前端會 404，因為 DB 沒 rule-set/worksheet）
DDM_SEED_DEMO=true

# ── 身分來源（見 docs/architecture/lb-most-auth.md）──
# 兩者適用情境不同，請按實際部署拓撲選（compose 內建預設是 gateway）：
#   gateway＝信任 ForwardAuth 注入的 X-Username。**前提：MOST 的 port 只有 gateway
#            連得到**（compose 已把 app port 綁 127.0.0.1）。前提破了＝零憑證 admin。
#   verify ＝MOST 自己拿 session cookie 打 LB /auth/verify 驗身分，不讀 client 的
#            X-Username。過渡期用：MOST 需要獨立開 port 對外時選這個。
# 下面這行是**過渡期**的建議值；已把 MOST 收到 Traefik 後面的話請改成 gateway。
DDM_AUTH_MODE=verify
DDM_LB_VERIFY_URL=http://<server-ip>/auth/verify
DDM_SESSION_COOKIE_NAME=session_id

# gateway 模式專用：營運者「已確認本服務只經可信 gateway 可達」的**宣告**，
# 設了就不再發啟動警告。⚠️ 這是宣告不是驗證——程式**不會**比對來源 IP/CIDR，
# 設了它並不會讓服務變安全，只是承認你已檢查過拓撲（防線仍是 port 綁定 + Traefik）。
# DDM_TRUSTED_GATEWAY=1

# ── CORS（前端與 API 同源時其實用不到；保留供特殊情況）──
# ⚠️ 不得把 ORIGINS 設成 `*` 又同時 CREDENTIALS=true：Starlette 在該組合下會鏡射
# 任意 Origin 並允許帶憑證（＝任何網站都能用受害者的登入態打本 API），啟動會直接失敗。
# 未設定時的預設已是 fail-closed（本機 loopback 白名單），不是 `*`。
DDM_CORS_ALLOW_ORIGINS=http://127.0.0.1:8877,http://localhost:8877
DDM_CORS_ALLOW_METHODS=GET,POST,PUT,DELETE
DDM_CORS_ALLOW_HEADERS=Authorization,Content-Type
DDM_CORS_ALLOW_CREDENTIALS=true
